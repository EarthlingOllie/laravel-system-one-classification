{
    "name": "earthlingollie/laravel-system-one-classification",
    "description": "A typed, immutable Laravel client for System 1 decision models (Laya, Jev and compatible models).",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "laya",
        "jev",
        "system-one",
        "classification"
    ],
    "require": {
        "php": "^8.4",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.8",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^3.8.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "EarthlingOllie\\SystemOneClassification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EarthlingOllie\\SystemOneClassification\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EarthlingOllie\\SystemOneClassification\\Laravel\\SystemOneServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
